# ==============================================================================
# CivicSense Cloud Database Configuration (Supabase)
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your Project URL and Anon/Service-Role Key.
# 3. In the Supabase SQL Editor, run the SQL script provided in 'supabase_schema.sql'.
# 4. Fill in the values below:

# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase API Key (anon public key or service_role secret key)
SUPABASE_KEY=

# Storage bucket name for complaint photo evidence (default: civicsense-uploads)
SUPABASE_BUCKET=civicsense-uploads

# Database Mode: 'auto' (connects to Supabase if keys provided, falls back to SQLite),
# 'supabase' (forces Supabase), or 'sqlite' (local SQLite only)
DB_MODE=auto
