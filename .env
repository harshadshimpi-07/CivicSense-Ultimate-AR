# ==============================================================================
# CivicSense Cloud Database Configuration (Supabase)
# ==============================================================================
# Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# Supabase API Key (Anon Key or Service Role Key)
SUPABASE_KEY=

# Storage bucket name for complaint photo evidence
SUPABASE_BUCKET=civicsense-uploads

# Database Mode: 'auto', 'supabase', or 'sqlite'
DB_MODE=auto
